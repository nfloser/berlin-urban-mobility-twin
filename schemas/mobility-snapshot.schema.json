{
  "$defs": {
    "DataAvailability": {
      "enum": [
        "scheduled",
        "observed",
        "realtime",
        "historical",
        "missing",
        "unknown"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "DataQuality": {
      "properties": {
        "is_valid": {
          "default": true,
          "title": "Is Valid",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/QualitySeverity",
          "default": "info"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "DataQuality",
      "type": "object"
    },
    "DisruptionCategory": {
      "enum": [
        "construction",
        "closure",
        "incident",
        "event",
        "other",
        "unknown"
      ],
      "title": "DisruptionCategory",
      "type": "string"
    },
    "FreshnessStatus": {
      "enum": [
        "fresh",
        "stale",
        "expired",
        "unknown"
      ],
      "title": "FreshnessStatus",
      "type": "string"
    },
    "MobilityDomain": {
      "enum": [
        "transit",
        "traffic"
      ],
      "title": "MobilityDomain",
      "type": "string"
    },
    "MobilityStateRecord": {
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "crs": {
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/MobilityDomain"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessStatus"
        },
        "geometry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry"
        },
        "location_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Reference"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "observation_status": {
          "$ref": "#/$defs/DataAvailability"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "entity_id",
        "timestamp",
        "observation_status",
        "provenance",
        "freshness",
        "quality"
      ],
      "title": "MobilityStateRecord",
      "type": "object"
    },
    "NetworkDisruption": {
      "properties": {
        "category": {
          "$ref": "#/$defs/DisruptionCategory"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "crs": {
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "disruption_id": {
          "title": "Disruption Id",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessStatus"
        },
        "geometry": {
          "additionalProperties": true,
          "title": "Geometry",
          "type": "object"
        },
        "observation_status": {
          "$ref": "#/$defs/DataAvailability"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "disruption_id",
        "timestamp",
        "geometry",
        "category",
        "observation_status",
        "provenance",
        "freshness",
        "quality"
      ],
      "title": "NetworkDisruption",
      "type": "object"
    },
    "Provenance": {
      "properties": {
        "dataset_title": {
          "minLength": 1,
          "title": "Dataset Title",
          "type": "string"
        },
        "freshness": {
          "$ref": "#/$defs/FreshnessStatus",
          "default": "unknown"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "observation_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation At"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "quality_warnings": {
          "items": {
            "type": "string"
          },
          "title": "Quality Warnings",
          "type": "array"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_metadata_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Metadata Url"
        },
        "source_url": {
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "provider",
        "dataset_title",
        "retrieved_at",
        "source_url",
        "licence"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QualitySeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "QualitySeverity",
      "type": "string"
    }
  },
  "properties": {
    "disruptions": {
      "items": {
        "$ref": "#/$defs/NetworkDisruption"
      },
      "title": "Disruptions",
      "type": "array"
    },
    "missing_sources": {
      "items": {
        "type": "string"
      },
      "title": "Missing Sources",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_errors": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Errors",
      "type": "object"
    },
    "source_status": {
      "additionalProperties": {
        "$ref": "#/$defs/FreshnessStatus"
      },
      "title": "Source Status",
      "type": "object"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/MobilityStateRecord"
      },
      "title": "States",
      "type": "array"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "timestamp"
  ],
  "title": "IntegrationMobilitySnapshot",
  "type": "object"
}
