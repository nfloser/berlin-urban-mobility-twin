# Runtime configuration. No secrets are required for the documented public sources.
MOBILITY_API_HOST=0.0.0.0
MOBILITY_API_PORT=8000
MOBILITY_HTTP_TIMEOUT_SECONDS=30
MOBILITY_REALTIME_STALE_AFTER_SECONDS=120
MOBILITY_USER_AGENT=berlin-urban-mobility-twin/0.1 (+https://github.com/nfloser/berlin-urban-mobility-twin)
# Optional override when serving a pre-built frontend from a non-standard path.
# MOBILITY_FRONTEND_DIR=/absolute/path/to/frontend/dist
